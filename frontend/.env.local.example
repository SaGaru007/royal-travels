# Base URL of the RoyalTravels Spring Boot API.
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# Production example (set this in the Vercel project settings):
# NEXT_PUBLIC_API_BASE_URL=https://royal-travels-api.onrender.com

# Business contact details. Optional: the defaults live in lib/site.ts. Set them
# here (or in Vercel) to change the number, email, address or hours without
# touching components. Empty address/hours are omitted from the UI.
# NEXT_PUBLIC_CONTACT_PHONE=+919986780221
# NEXT_PUBLIC_CONTACT_EMAIL=bookings@royaltravels.in
# NEXT_PUBLIC_BUSINESS_ADDRESS=
# NEXT_PUBLIC_BUSINESS_HOURS=
