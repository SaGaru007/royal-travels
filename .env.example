# ---------------------------------------------------------------------------
# RoyalTravels API — environment template
#
# Copy the values into your hosting provider's environment settings.
# NEVER commit a filled-in copy of this file.
#
# Local development uses config/application-local.properties instead (gitignored)
# because the default profile is "local" and Spring Boot loads it automatically.
# ---------------------------------------------------------------------------

# Active Spring profile. Use "prod" in production.
SPRING_PROFILES_ACTIVE=prod

# --- Database (Supabase session pooler) ------------------------------------
# Keep the JDBC prefix; this is a Java service, not a Node service.
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# --- Authentication --------------------------------------------------------
# At least 32 bytes. Generate with: openssl rand -base64 48
# Startup fails if this is empty or too short.
JWT_SECRET=<48-random-characters>

# --- First owner account (optional) ---------------------------------------
# Used only at startup, and only if the email does not already exist.
# Changing these later does NOT reset an existing password; use /admin/settings.
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=<strong-unique-password>

# --- Browser access --------------------------------------------------------
# Exact origins, comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Runtime ---------------------------------------------------------------
# Render sets PORT automatically; 8081 is the local default.
# PORT=8081

# Recommended on the 512 MB Render free instance.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70

# Keep these at "never" in production. The prod profile already forces this.
ERROR_INCLUDE_MESSAGE=never
ERROR_INCLUDE_BINDING_ERRORS=never

# ---------------------------------------------------------------------------
# Frontend (set in Vercel, not on the API)
#
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
#
# NEXT_PUBLIC_* values are baked in at build time. Changing the API URL requires
# a new frontend deployment.
# ---------------------------------------------------------------------------
